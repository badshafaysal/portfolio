---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  ogType?: string;
}
const {
  title = 'Badsha Faysal — Senior Structural Detailer',
  description = 'Senior Structural Detailer specializing in Tekla Structures, fabrication-ready steel detailing, shop drawings, erection plans and BOM for industrial projects. Based in Dhaka, Bangladesh.',
  ogImage = '/images/profile.jpg',
  canonical,
  ogType = 'website',
} = Astro.props;
const siteUrl = (Astro.site ?? new URL('https://badshafaysal.pages.dev')).origin;
const pageUrl = canonical ? `${siteUrl}${canonical}` : siteUrl;
const imageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#070b14" />
  <meta name="author" content="Badsha Faysal" />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:site_name" content="Badsha Faysal — Senior Structural Detailer" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/images/profile.jpg" />
  <link rel="canonical" href={pageUrl} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
  <noscript><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" /></noscript>
  <script is:inline>
    // Apply saved theme before paint (prevents dark/light flash)
    (function(){try{var t=localStorage.theme;var d=t?t==="dark":matchMedia("(prefers-color-scheme: dark)").matches;document.documentElement.classList.toggle("dark",d);}catch(e){}})();
  </script>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <slot />
  <button type="button" class="to-top" id="to-top" aria-label="Back to top" title="Back to top">
    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5m0 0l-6 6m6-6l6 6"/></svg>
  </button>
  <script src="/main.js" defer></script>
</body>
</html>
