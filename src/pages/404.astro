---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Badsha Faysal">
  <main id="main" class="project-page">
    <div class="section-inner project-page-inner" style="text-align:center;padding-block:6rem">
      <p class="section-label">404</p>
      <h1 class="project-title">Page not found</h1>
      <p class="project-lead" style="margin-inline:auto">That page doesn’t exist or has moved.</p>
      <p class="cta-row">
        <a href="/#projects" class="btn btn-primary">View projects</a>
        <a href="/" class="btn btn-ghost">Home</a>
        <a href="/#contact" class="btn btn-ghost">Contact</a>
      </p>
    </div>
  </main>
</Base>
