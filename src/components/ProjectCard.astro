---
import { PROJECT_SIZES } from '../lib/images';
import { labelForCategory } from '../lib/categories';

interface Props {
  title: string;
  description: string;
  category: string[];
  tags?: string;
  image: string;
  slug: string;
  location?: string;
  featured?: boolean;
  index?: number;
}

const {
  title,
  description,
  category,
  tags,
  image,
  slug,
  location,
  featured = false,
  index = 0,
} = Astro.props;

const categoryStr = category.join(' ');
const searchText = [title, description, tags, location, ...category.map(labelForCategory)].filter(Boolean).join(' ').toLowerCase();
const displayTags = tags || category.join(' · ');
const delay = (index % 6) * 0.05;
const priority = index < 3;

function webpPath(src: string): string | null {
  if (!src || src.startsWith('http') || src.startsWith('data:')) return null;
  if (/\.jpe?g$/i.test(src)) return src.replace(/\.jpe?g$/i, '.webp');
  if (/\.png$/i.test(src)) return src.replace(/\.png$/i, '.webp');
  return null;
}

const webp = webpPath(image);
---

<a
  href={`/projects/${slug}/`}
  class="project-card reveal"
  style={`transition-delay:${delay}s`}
  data-category={categoryStr}
  data-search={searchText}
>
  <div class="img-wrap">
    {featured && <span class="badge-featured">★ Featured</span>}
    <picture>
      {webp && (
        <source type="image/webp" srcset={`${webp} 800w`} sizes={PROJECT_SIZES} />
      )}
      <img
        src={image}
        alt={title}
        width="800"
        height="600"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
        sizes={PROJECT_SIZES}
      />
    </picture>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p>{description}</p>
    <div class="card-meta">
      <span class="tag-line">{displayTags}</span>
      {location && <span class="card-loc">{location}</span>}
    </div>
  </div>
</a>
